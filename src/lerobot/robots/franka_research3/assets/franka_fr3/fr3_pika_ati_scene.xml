<mujoco model="fr3_pika_ati_scene">
  <include file="fr3_pika_ati.xml" />
  <option gravity="0 0 -9.81" />

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
    <rgba haze="0.15 0.25 0.35 1" />
    <global azimuth="-140" elevation="-30" offwidth="1280" offheight="720" />
  </visual>

  <asset>
    <texture type="skybox" builtin="flat" rgb1="0.08 0.10 0.14" rgb2="0.02 0.03 0.05" width="512" height="3072" />
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4"
      rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300" />
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2" />
    <material name="table_surface" rgba="0.38 0.28 0.22 1" />
    <material name="workspace_object_material" rgba="0.85 0.25 0.18 1" />
    <material name="peg_hole_material" rgba="0.18 0.55 0.72 1" />
  </asset>

  <worldbody>
    <light name="key_light" pos="0.4 -0.3 1.6" dir="0.1 0.0 -1" directional="true" castshadow="true" />
    <light name="fill_light" pos="-0.6 0.4 1.2" dir="0.2 -0.1 -1" directional="true" diffuse="0.35 0.35 0.35" />
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" />

    <!-- Four front cameras on the far side of the table (two upper, two lower),
         plus one side camera on each side. Use projected world-up to keep images upright. -->
    <camera name="third_person_cam" pos="1.30 0.42 1.32" xyaxes="-0.464834 0.885398 0 -0.610425 -0.320473 0.724347" fovy="45"/>
    <camera name="north_east_cam" pos="1.30 -0.42 1.32" xyaxes="0.464834 0.885398 0 -0.610425 0.320473 0.724347" fovy="45"/>
    <camera name="side_cam" pos="1.14 0.24 0.98" xyaxes="-0.351123 0.936329 0 -0.566920 -0.212595 0.795868" fovy="45"/>
    <camera name="west_cam" pos="1.14 -0.24 0.98" xyaxes="0.351123 0.936329 0 -0.566920 0.212595 0.795868" fovy="45"/>
    <camera name="south_west_cam" pos="0.52 0.92 1.08" xyaxes="-0.999764 0.021734 0 -0.012144 -0.558631 0.829328" fovy="45"/>
    <camera name="south_east_cam" pos="0.52 -0.92 1.08" xyaxes="0.999764 0.021734 0 -0.012144 0.558631 0.829328" fovy="45"/>

    <body name="table_body" pos="0.52 0 0.38">
      <geom name="table" type="box" size="0.34 0.46 0.02" material="table_surface" friction="1.2 0.05 0.01"/>
      <geom type="box" pos="0.28 0.40 -0.34" size="0.03 0.03 0.34" material="table_surface"/>
      <geom type="box" pos="0.28 -0.40 -0.34" size="0.03 0.03 0.34" material="table_surface"/>
      <geom type="box" pos="-0.28 0.40 -0.34" size="0.03 0.03 0.34" material="table_surface"/>
      <geom type="box" pos="-0.28 -0.40 -0.34" size="0.03 0.03 0.34" material="table_surface"/>

      <!-- Fixed peg-in-hole socket.
           The rectangular peg is the workspace_object (0.05 x 0.05 x 0.08 full size).
           The socket inner cross-section is 0.06 x 0.06, leaving ~5 mm clearance per side. -->
      <body name="peg_hole_fixture_body" pos="0.10 -0.16 0.02">
        <geom name="peg_hole_base" type="box" pos="0 0 0.005" size="0.035 0.035 0.005"
              material="peg_hole_material" friction="1.4 0.05 0.01" condim="4"/>
        <geom name="peg_hole_wall_x_pos" type="box" pos="0.034 0 0.0375" size="0.004 0.035 0.0275"
              material="peg_hole_material" friction="1.4 0.05 0.01" condim="4"/>
        <geom name="peg_hole_wall_x_neg" type="box" pos="-0.034 0 0.0375" size="0.004 0.035 0.0275"
              material="peg_hole_material" friction="1.4 0.05 0.01" condim="4"/>
        <geom name="peg_hole_wall_y_pos" type="box" pos="0 0.034 0.0375" size="0.030 0.004 0.0275"
              material="peg_hole_material" friction="1.4 0.05 0.01" condim="4"/>
        <geom name="peg_hole_wall_y_neg" type="box" pos="0 -0.034 0.0375" size="0.030 0.004 0.0275"
              material="peg_hole_material" friction="1.4 0.05 0.01" condim="4"/>
      </body>
    </body>

    <body name="workspace_object_body" pos="0.48 0.00 0.44">
      <freejoint/>
      <geom name="workspace_object" type="box" size="0.025 0.025 0.04" material="workspace_object_material" density="500" friction="1.8 0.05 0.01" condim="4" />
    </body>

    <!-- <body name="target" pos="0.45 0.10 0.50" quat="0 1 0 0" mocap="true">
      <geom type="box" size="0.03 0.03 0.03" contype="0" conaffinity="0" rgba="0.1 0.9 0.2 0.25" />
      <site type="sphere" name="target_site" size="0.005" rgba="0 0 1 1" group="1" />
    </body>

    <body name="TCP" pos="0.365 0 0.4" quat="0 1 0 0" mocap="true">
      <geom type="sphere" size="0.03" contype="0" conaffinity="0" rgba="0.95 0.45 0.1 0.25" />
      <site type="sphere" name="TCP_site" size="0.005" rgba="0 0 1 1" group="1" />
    </body> -->
  </worldbody>
</mujoco>
